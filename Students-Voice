<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Student Voices | Nketia-Marfo</title>

    <meta
        name="description"
        content="Student Voices by Nketia-Marfo — stories, experiences, ideas and lessons from students around the world."
    >

    <link rel="stylesheet" href="style.css">

    <style>
        /* =========================================================
           NKETIA-MARFO — STUDENT VOICES
           ========================================================= */

        :root {
            --blue: #0B1F3A;
            --blue-2: #163A63;
            --red: #A61B29;
            --red-2: #C83A48;
            --green: #176B45;
            --green-2: #2E8B68;
            --silver: #B8BEC7;
            --silver-light: #E5E7EB;
            --white: #FFFFFF;
            --cream: #F7F8FA;
            --text: #17202A;
            --muted: #66727F;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            background: var(--cream);
            color: var(--text);
            font-family: "Segoe UI", Arial, Helvetica, sans-serif;
            line-height: 1.7;
        }

        a {
            text-decoration: none;
        }

        img {
            max-width: 100%;
        }

        /* =========================================================
           HEADER
           ========================================================= */

        .site-header {
            position: sticky;
            top: 0;
            z-index: 9999;
            background: rgba(255,255,255,0.97);
            border-bottom: 1px solid var(--silver-light);
            backdrop-filter: blur(12px);
        }

        .header-inner {
            width: min(1180px, 92%);
            min-height: 76px;
            margin: auto;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 25px;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 10px;
            color: var(--blue);
            flex-shrink: 0;
        }

        .brand-mark {
            width: 43px;
            height: 43px;
            border-radius: 50%;
            background: var(--blue);
            color: white;
            display: flex;
            justify-content: center;
            align-items: center;
            font-family: Georgia, serif;
            font-weight: bold;
            position: relative;
        }

        .brand-mark::after {
            content: "";
            width: 9px;
            height: 9px;
            border-radius: 50%;
            background: var(--red);
            position: absolute;
            right: -2px;
            top: -2px;
        }

        .brand-name {
            font-family: Georgia, "Times New Roman", serif;
            font-size: 22px;
            font-weight: bold;
        }

        .main-nav {
            display: flex;
            align-items: center;
            justify-content: flex-end;
            flex-wrap: wrap;
            gap: 5px;
        }

        .nav-link {
            padding: 9px 13px;
            border-radius: 7px;
            color: var(--text);
            font-size: 14px;
            font-weight: 600;
            transition: 0.25s ease;
        }

        .nav-link:hover {
            color: var(--red);
            background: var(--cream);
        }

        .nav-link.active {
            background: var(--blue);
            color: white;
        }

        /* =========================================================
           HERO
           ========================================================= */

        .voices-hero {
            position: relative;
            overflow: hidden;
            background:
                linear-gradient(
                    135deg,
                    var(--blue),
                    var(--blue-2) 60%,
                    #19485A
                );
            color: white;
        }

        .voices-hero::before {
            content: "";
            position: absolute;
            width: 420px;
            height: 420px;
            border: 70px solid rgba(255,255,255,0.04);
            border-radius: 50%;
            right: -180px;
            top: -210px;
        }

        .voices-hero::after {
            content: "";
            position: absolute;
            width: 190px;
            height: 190px;
            background: var(--red);
            opacity: 0.12;
            border-radius: 50%;
            left: -100px;
            bottom: -100px;
        }

        .hero-content {
            width: min(1180px, 92%);
            min-height: 590px;
            margin: auto;
            display: grid;
            grid-template-columns: 1fr 0.9fr;
            align-items: center;
            gap: 65px;
            padding: 80px 0;
            position: relative;
            z-index: 2;
        }

        .hero-label {
            display: inline-block;
            margin-bottom: 17px;
            color: #C9D8E7;
            font-size: 12px;
            letter-spacing: 3px;
            font-weight: 800;
        }

        .hero-title {
            font-family: Georgia, "Times New Roman", serif;
            font-size: clamp(48px, 6vw, 76px);
            line-height: 1.02;
            margin-bottom: 25px;
        }

        .hero-title span {
            color: #DCE8F2;
        }

        .hero-description {
            max-width: 650px;
            color: #DCE5ED;
            font-size: 17px;
            line-height: 1.85;
            margin-bottom: 32px;
        }

        .hero-actions {
            display: flex;
            flex-wrap: wrap;
            gap: 12px;
        }

        .hero-button {
            display: inline-block;
            padding: 13px 22px;
            border-radius: 7px;
            font-weight: 700;
            transition: 0.25s ease;
        }

        .hero-button.primary {
            background: var(--red);
            color: white;
        }

        .hero-button.primary:hover {
            background: var(--red-2);
            transform: translateY(-2px);
        }

        .hero-button.secondary {
            color: white;
            border: 1px solid rgba(255,255,255,0.3);
            background: rgba(255,255,255,0.05);
        }

        .hero-button.secondary:hover {
            background: rgba(255,255,255,0.12);
        }

        /* =========================================================
           HERO PHOTOS
           ========================================================= */

        .hero-visual {
            height: 450px;
            position: relative;
        }

        .photo-frame {
            position: absolute;
            padding: 9px;
            background: white;
            box-shadow: 0 20px 50px rgba(0,0,0,0.28);
        }

        .photo-frame img {
            width: 100%;
            height: 100%;
            display: block;
            object-fit: cover;
        }

        .photo-one {
            width: 245px;
            height: 305px;
            right: 15px;
            top: 5px;
            transform: rotate(4deg);
            z-index: 2;
        }

        .photo-two {
            width: 190px;
            height: 235px;
            left: 0;
            top: 110px;
            transform: rotate(-5deg);
            z-index: 4;
        }

        .photo-three {
            width: 175px;
            height: 215px;
            right: 145px;
            bottom: 0;
            transform: rotate(-2deg);
            z-index: 5;
        }

        .photo-caption {
            position: absolute;
            left: 18px;
            bottom: 17px;
            padding: 12px 17px;
            background: var(--green);
            color: white;
            font-size: 12px;
            font-weight: 800;
            box-shadow: 0 10px 25px rgba(0,0,0,0.2);
            z-index: 10;
        }

        /* =========================================================
           INTRO
           ========================================================= */

        .voices-intro {
            width: min(850px, 92%);
            margin: auto;
            text-align: center;
            padding: 85px 0 45px;
        }

        .section-label {
            color: var(--red);
            font-size: 11px;
            letter-spacing: 3px;
            font-weight: 800;
            margin-bottom: 12px;
            text-transform: uppercase;
        }

        .voices-intro h2 {
            color: var(--blue);
            font-family: Georgia, "Times New Roman", serif;
            font-size: clamp(32px, 4vw, 47px);
            line-height: 1.2;
            margin-bottom: 20px;
        }

        .voices-intro p {
            color: var(--muted);
            font-size: 16px;
        }

        /* =========================================================
           PERSONAL PHOTO INTRO
           ========================================================= */

        .personal-intro {
            width: min(1080px, 92%);
            margin: 30px auto 75px;
            background: white;
            border: 1px solid var(--silver-light);
            box-shadow: 0 15px 45px rgba(11,31,58,0.07);
            display: grid;
            grid-template-columns: 0.9fr 1.1fr;
            overflow: hidden;
        }

        .personal-intro-photo {
            min-height: 390px;
            overflow: hidden;
        }

        .personal-intro-photo img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }

        .personal-intro-text {
            padding: 55px;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .personal-intro-text h2 {
            color: var(--blue);
            font-family: Georgia, serif;
            font-size: 35px;
            line-height: 1.25;
            margin-bottom: 18px;
        }

        .personal-intro-text p {
            color: var(--muted);
            font-size: 15px;
            margin-bottom: 14px;
        }

        .personal-signature {
            margin-top: 12px;
            color: var(--green);
            font-family: Georgia, serif;
            font-weight: bold;
        }

        /* =========================================================
           STATS
           ========================================================= */

        .voice-stats {
            width: min(1000px, 92%);
            margin: 10px auto 70px;
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 18px;
        }

        .stat-card {
            background: white;
            border: 1px solid var(--silver-light);
            border-radius: 12px;
            padding: 28px;
            text-align: center;
            box-shadow: 0 8px 25px rgba(11,31,58,0.05);
        }

        .stat-number {
            display: block;
            color: var(--blue);
            font-family: Georgia, serif;
            font-size: 39px;
            font-weight: bold;
        }

        .stat-text {
            color: var(--muted);
            font-size: 13px;
            font-weight: 700;
        }

        /* =========================================================
           STORIES HEADER
           ========================================================= */

        .voices-section {
            padding-bottom: 10px;
        }

        .voices-tools {
            width: min(1180px, 92%);
            margin: auto;
            margin-bottom: 28px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 25px;
        }

        .voices-tools h2 {
            color: var(--blue);
            font-family: Georgia, serif;
            font-size: 34px;
        }

        .voices-tools h2 span {
            color: var(--red);
        }

        .search-box {
            width: min(360px, 100%);
        }

        .search-box input {
            width: 100%;
            padding: 14px 17px;
            border: 1px solid var(--silver);
            border-radius: 8px;
            background: white;
            outline: none;
            font-size: 14px;
        }

        .search-box input:focus {
            border-color: var(--blue);
        }

        /* =========================================================
           STORY DIVIDER PHOTO
           ========================================================= */

        .story-photo {
            width: min(1000px, 92%);
            height: 300px;
            margin: 15px auto 55px;
            overflow: hidden;
            border-radius: 15px;
            box-shadow: 0 15px 40px rgba(11,31,58,0.12);
        }

        .story-photo img {
            width: 100%;
            height: 100%;
            display: block;
            object-fit: cover;
        }

        /* =========================================================
           VOICE CARDS
           ========================================================= */

        .voices-grid {
            width: min(1180px, 92%);
            margin: auto;
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 25px;
            padding-bottom: 45px;
        }

        .voice-card {
            background: white;
            border: 1px solid var(--silver-light);
            border-radius: 13px;
            overflow: hidden;
            box-shadow: 0 8px 30px rgba(11,31,58,0.055);
            transition: 0.25s ease;
        }

        .voice-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 17px 40px rgba(11,31,58,0.12);
        }

        .voice-top {
            padding: 25px 25px 16px;
            display: flex;
            align-items: center;
            gap: 13px;
        }

        .voice-number {
            width: 44px;
            height: 44px;
            min-width: 44px;
            border-radius: 50%;
            background: var(--blue);
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: Georgia, serif;
            font-weight: bold;
        }

        .voice-country {
            font-size: 24px;
        }

        .voice-author {
            color: var(--blue);
            font-family: Georgia, serif;
            font-size: 19px;
            line-height: 1.25;
        }

        .voice-content {
            padding: 7px 25px 28px;
        }

        .voice-title {
            color: var(--red);
            font-family: Georgia, serif;
            font-size: 21px;
            line-height: 1.4;
            margin-bottom: 14px;
        }

        .voice-explanation {
            color: var(--muted);
            font-size: 14px;
            line-height: 1.8;
        }

        .voice-bottom {
            border-top: 1px solid var(--silver-light);
            padding: 14px 25px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .voice-tag {
            color: var(--green);
            font-size: 10px;
            letter-spacing: 1.5px;
            font-weight: 800;
            text-transform: uppercase;
        }

        .voice-dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: var(--red);
        }

        /* =========================================================
           FEATURED PERSONAL PHOTO
           ========================================================= */

        .personal-feature {
            width: min(1050px, 92%);
            margin: 35px auto 75px;
            position: relative;
            overflow: hidden;
            min-height: 390px;
            border-radius: 15px;
            box-shadow: 0 18px 45px rgba(11,31,58,0.16);
        }

        .personal-feature img {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .personal-feature-overlay {
            position: absolute;
            inset: 0;
            background: linear-gradient(
                90deg,
                rgba(11,31,58,0.88),
                rgba(11,31,58,0.45),
                rgba(11,31,58,0.12)
            );
            display: flex;
            align-items: center;
        }

        .personal-feature-content {
            width: min(620px, 85%);
            margin-left: 55px;
            color: white;
        }

        .personal-feature-content .section-label {
            color: #D6E2ED;
        }

        .personal-feature-content h2 {
            font-family: Georgia, serif;
            font-size: clamp(32px, 4vw, 48px);
            line-height: 1.2;
            margin-bottom: 15px;
        }

        .personal-feature-content p {
            color: #E2EAF1;
            font-size: 15px;
        }

        /* =========================================================
           BIGGER PICTURE
           ========================================================= */

        .featured-message {
            position: relative;
            overflow: hidden;
            background: var(--blue);
            color: white;
        }

        .featured-message::before {
            content: "";
            position: absolute;
            width: 350px;
            height: 350px;
            border: 60px solid rgba(255,255,255,0.04);
            border-radius: 50%;
            right: -120px;
            top: -150px;
        }

        .featured-inner {
            width: min(900px, 92%);
            margin: auto;
            text-align: center;
            padding: 90px 0;
            position: relative;
            z-index: 2;
        }

        .featured-inner .section-label {
            color: #C7D6E5;
        }

        .featured-inner h2 {
            font-family: Georgia, serif;
            font-size: clamp(31px, 4vw, 47px);
            line-height: 1.25;
            margin-bottom: 20px;
        }

        .featured-inner p {
            color: #D8E2EB;
            font-size: 16px;
            max-width: 720px;
            margin: auto;
        }

        /* =========================================================
           CTA
           ========================================================= */

        .voice-cta {
            width: min(1050px, 92%);
            margin: 70px auto;
            padding: 43px;
            background: white;
            border: 1px solid var(--silver-light);
            border-left: 6px solid var(--green);
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 30px;
            box-shadow: 0 10px 35px rgba(11,31,58,0.06);
        }

        .voice-cta h2 {
            color: var(--blue);
            font-family: Georgia, serif;
            font-size: 31px;
            margin-bottom: 7px;
        }

        .voice-cta p {
            color: var(--muted);
            font-size: 14px;
        }

        .cta-button {
            padding: 13px 23px;
            border-radius: 7px;
            background: var(--green);
            color: white;
            font-weight: 700;
            white-space: nowrap;
            transition: 0.25s ease;
        }

        .cta-button:hover {
            background: var(--green-2);
            transform: translateY(-2px);
        }

        /* =========================================================
           FOOTER
           ========================================================= */

        .site-footer {
            background: var(--blue);
            color: white;
            padding: 60px 0 25px;
        }

        .footer-inner {
            width: min(1180px, 92%);
            margin: auto;
            display: grid;
            grid-template-columns: 1.5fr 1fr 1fr;
            gap: 50px;
            padding-bottom: 40px;
        }

        .footer-brand h2 {
            font-family: Georgia, serif;
            font-size: 28px;
            margin-bottom: 10px;
        }

        .footer-brand p {
            color: #C9D4DF;
            max-width: 430px;
            font-size: 14px;
        }

        .footer-column h3 {
            font-family: Georgia, serif;
            margin-bottom: 15px;
        }

        .footer-links {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .footer-links a {
            color: #C9D4DF;
            font-size: 13px;
            transition: 0.2s;
        }

        .footer-links a:hover {
            color: white;
        }

        .footer-bottom {
            width: min(1180px, 92%);
            margin: auto;
            padding-top: 20px;
            border-top: 1px solid rgba(255,255,255,0.12);
            display: flex;
            justify-content: space-between;
            gap: 20px;
            color: #9EABB8;
            font-size: 12px;
        }

        /* =========================================================
           RESPONSIVE
           ========================================================= */

        @media (max-width: 900px) {

            .hero-content {
                grid-template-columns: 1fr;
                gap: 25px;
            }

            .hero-visual {
                width: 100%;
                max-width: 520px;
                margin: auto;
            }

            .voices-grid {
                grid-template-columns: 1fr;
            }

            .personal-intro {
                grid-template-columns: 1fr;
            }

            .personal-intro-photo {
                min-height: 350px;
            }

            .footer-inner {
                grid-template-columns: 1fr 1fr;
            }

            .footer-brand {
                grid-column: 1 / -1;
            }
        }

        @media (max-width: 700px) {

            .header-inner {
                padding: 14px 0;
                flex-direction: column;
                gap: 12px;
            }

            .main-nav {
                justify-content: center;
            }

            .nav-link {
                font-size: 12px;
                padding: 7px 9px;
            }

            .hero-content {
                padding: 65px 0;
            }

            .hero-title {
                font-size: 49px;
            }

            .hero-description {
                font-size: 15px;
            }

            .voice-stats {
                grid-template-columns: 1fr;
            }

            .voices-tools {
                flex-direction: column;
                align-items: stretch;
            }

            .voices-tools h2 {
                font-size: 30px;
            }

            .story-photo {
                height: 240px;
            }

            .personal-intro-text {
                padding: 35px 25px;
            }

            .personal-feature {
                min-height: 420px;
            }

            .personal-feature-content {
                margin-left: 25px;
            }

            .voice-cta {
                flex-direction: column;
                align-items: flex-start;
                padding: 32px;
            }

            .footer-inner {
                grid-template-columns: 1fr;
                gap: 30px;
            }

            .footer-brand {
                grid-column: auto;
            }

            .footer-bottom {
                flex-direction: column;
            }
        }

        @media (max-width: 500px) {

            .hero-title {
                font-size: 42px;
            }

            .hero-visual {
                height: 320px;
            }

            .photo-one {
                width: 175px;
                height: 220px;
            }

            .photo-two {
                width: 135px;
                height: 170px;
                top: 90px;
            }

            .photo-three {
                width: 120px;
                height: 150px;
                right: 85px;
            }

            .photo-caption {
                left: 3px;
                bottom: 3px;
                font-size: 10px;
            }

            .voice-top,
            .voice-content,
            .voice-bottom {
                padding-left: 18px;
                padding-right: 18px;
            }

            .story-photo {
                height: 200px;
            }
        }
    </style>
</head>

